# ─────────────────────────────────────────────────────────────
# Wetriip Supply OS — environment
# ─────────────────────────────────────────────────────────────

# Postgres (source of truth: catalog, contracts, bookings, ledger)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wetriip_supply_os?schema=public"

PORT=3100
NODE_ENV=development

# ── Agent Control Plane ──────────────────────────────────────
# The LLM is OPTIONAL. Without a key the platform runs the
# deterministic grammar parser: the same StructuredCommand, the
# same policy/simulation/execution path. The LLM only ever
# produces intent — it never touches inventory, price or bookings.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Global autonomy ceiling: 1=Observe, 2=Recommend, 3=Execute
AGENT_MAX_AUTONOMY=2

# ── Policy limits (hard gates, enforced in code) ─────────────
POLICY_MAX_DISCOUNT_PCT=25
POLICY_MAX_RATE_DELTA_PCT=20
POLICY_MAX_BLAST_RADIUS_CELLS=5000
POLICY_FLOOR_RATE_ENABLED=true

# ── ARI freshness SLA (seconds) ──────────────────────────────
ARI_FRESHNESS_SLA_SECONDS=3600

# ── Offers ───────────────────────────────────────────────────
OFFER_TTL_SECONDS=900
OFFER_SIGNING_SECRET=change-me-in-production

# ── FX ───────────────────────────────────────────────────────
# Static table for development. Replace with a rate provider in prod.
FX_NORMALIZATION_CURRENCY=USD
FX_SOURCE=static-dev-table

# ── Connectivity ─────────────────────────────────────────────
CONNECTIVITY_PULL_ENABLED=true
CONNECTIVITY_PULL_CRON="0 */5 * * * *"
RECONCILIATION_ENABLED=true

# ── Identity and internal trust ──────────────────────────────
# The gateway signs the identity it forwards; internal services
# refuse context they cannot verify. Network isolation is defence
# in depth, not the only defence.
SESSION_SECRET=set-a-48-character-random-value-here-please-really
INTERNAL_SIGNING_SECRET=set-a-different-48-character-random-value-here-ok
INTERNAL_AUTH_REQUIRED=true
SESSION_TTL_MS=900000

# Production refuses to start without these. Development runs
# without them and says so on every boot.
# OIDC_ISSUER=https://id.wetriip.ai
# OIDC_CLIENT_ID=
# OIDC_JWKS_URI=
# STEP_UP_VERIFIER=

# Bind internal services to loopback unless the platform routes
# to them explicitly. Only the gateway needs to be reachable.
# BIND_HOST=127.0.0.1

# ── Group floor rate ─────────────────────────────────────────
# POLICY_FLOOR_RATE is only read when POLICY_FLOOR_RATE_ENABLED
# is true. Previously the flag existed and nothing loaded it.
POLICY_FLOOR_RATE=
POLICY_FLOOR_RATE_CURRENCY=COP

# ── Sign-in ──────────────────────────────────────────────────
# The development sign-in accepts any seeded email with NO
# credential. It must be switched on deliberately, because on a
# public URL it means anyone who read the README can sign in as
# the platform administrator. Production refuses to boot with it.
DEV_LOGIN_ENABLED=true

# ── Deploy ───────────────────────────────────────────────────
# Load demo data on every deploy. Off by default: a deploy that
# silently reseeds discards whatever the demo user just did.
SEED_ON_DEPLOY=false
