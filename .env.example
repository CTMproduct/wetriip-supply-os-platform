# ─────────────────────────────────────────────────────────────
# Wetriip Supply OS — environment
# ─────────────────────────────────────────────────────────────

# Postgres (source of truth: catalog, contracts, bookings, ledger)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wetriip_supply_os?schema=public"

PORT=3100
NODE_ENV=development

# ── Agent Control Plane ──────────────────────────────────────
# The LLM is OPTIONAL. Without a key the platform runs the
# deterministic grammar parser: the same StructuredCommand, the
# same policy/simulation/execution path. The LLM only ever
# produces intent — it never touches inventory, price or bookings.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Global autonomy ceiling: 1=Observe, 2=Recommend, 3=Execute
AGENT_MAX_AUTONOMY=2

# ── Policy limits (hard gates, enforced in code) ─────────────
POLICY_MAX_DISCOUNT_PCT=25
POLICY_MAX_RATE_DELTA_PCT=20
POLICY_MAX_BLAST_RADIUS_CELLS=5000
POLICY_FLOOR_RATE_ENABLED=true

# ── ARI freshness SLA (seconds) ──────────────────────────────
ARI_FRESHNESS_SLA_SECONDS=3600

# ── Offers ───────────────────────────────────────────────────
OFFER_TTL_SECONDS=900
OFFER_SIGNING_SECRET=change-me-in-production

# ── FX ───────────────────────────────────────────────────────
# Static table for development. Replace with a rate provider in prod.
FX_NORMALIZATION_CURRENCY=USD
FX_SOURCE=static-dev-table

# ── Connectivity ─────────────────────────────────────────────
CONNECTIVITY_PULL_ENABLED=true
CONNECTIVITY_PULL_CRON="0 */5 * * * *"
RECONCILIATION_ENABLED=true
