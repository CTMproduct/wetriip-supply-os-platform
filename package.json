{
  "name": "wetriip-supply-os",
  "version": "0.1.0",
  "private": true,
  "description": "Wetriip Supply OS \u2014 The Agentic Operating System for Travel Supply. Distributed service topology built around failure isolation: the connectivity fleet, the ARI ledger, search, booking and the agent control plane scale and fail independently.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:packages": "node scripts/build.js packages",
    "build:services": "node scripts/build.js services",
    "build": "node scripts/build.js all",
    "prisma:generate": "node node_modules/prisma/build/index.js generate --schema packages/persistence/prisma/schema.prisma",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev --schema packages/persistence/prisma/schema.prisma",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy --schema packages/persistence/prisma/schema.prisma",
    "prisma:push": "node node_modules/prisma/build/index.js db push --schema packages/persistence/prisma/schema.prisma",
    "seed": "node node_modules/ts-node/dist/bin.js --project tsconfig.base.json packages/persistence/prisma/seed.ts",
    "dev": "node services/all-in-one/dist/all-in-one/src/main.js",
    "start:gateway": "node services/gateway/dist/main.js",
    "start:core-commerce": "node services/core-commerce/dist/main.js",
    "start:connectivity": "node services/connectivity/dist/main.js",
    "start:ari-ingestion": "node services/ari-ingestion/dist/main.js",
    "start:search": "node services/search/dist/main.js",
    "start:booking": "node services/booking/dist/main.js",
    "start:agent": "node services/agent/dist/main.js",
    "start:groups": "node services/groups/dist/main.js",
    "start:reconciliation": "node services/reconciliation/dist/main.js",
    "test": "node node_modules/jest/bin/jest.js",
    "test:e2e": "node node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand",
    "web:dev": "node node_modules/vite/bin/vite.js --config web/vite.config.ts",
    "web:build": "node node_modules/vite/bin/vite.js build --config web/vite.config.ts",
    "bootstrap:ari": "node scripts/bootstrap-ari.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^6.5.0",
    "decimal.js": "^10.4.3",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/packages",
      "<rootDir>/services"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@wetriip/contracts$": "<rootDir>/packages/contracts/src/index.ts",
      "^@wetriip/domain$": "<rootDir>/packages/domain/src/index.ts",
      "^@wetriip/bus$": "<rootDir>/packages/bus/src/index.ts",
      "^@wetriip/persistence$": "<rootDir>/packages/persistence/src/index.ts",
      "^@wetriip/connectivity-sdk$": "<rootDir>/packages/connectivity-sdk/src/index.ts",
      "^@wetriip/observability$": "<rootDir>/packages/observability/src/index.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.base.json",
          "isolatedModules": true
        }
      ]
    }
  }
}
